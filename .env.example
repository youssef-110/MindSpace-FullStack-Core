# Copy to .env (never commit .env). Only GEMINI_API_KEY is needed for the AI features.
GEMINI_API_KEY=
# Optional: models tried in order (each has its own free-tier quota).
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-flash-latest
# Optional last-resort fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
